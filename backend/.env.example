# Database Configuration (Defaults to SQLite if omitted in local non-docker mode)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/smart_attendance

# Authentication Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Resend Email Automation API Key (https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
