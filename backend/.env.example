# Database Configuration (PostgreSQL / Supabase / SQLite)
DATABASE_URL=postgresql://postgres.your_project:your_password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Authentication Secret Key (256-bit cryptographically secure hex)
SECRET_KEY=generate_with_python_secrets_token_hex_32

# Production Resend Email Automation API Key
RESEND_API_KEY=re_your_api_key_here

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Google Gemini AI API Key (AI Copilot & Advisor)
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Live Dispatch Configuration (Real Emails & OTPs)
SMTP_USER=your_institutional_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# System Environment & Governance Flags
DEBUG=false
SETUP_COMPLETED=false
DEFAULT_STUDENT_PASSWORD=Student@Secure2026!
