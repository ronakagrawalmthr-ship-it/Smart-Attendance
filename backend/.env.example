# ==============================================================================
# SMART ATTENDANCE AI - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Configuration (Defaults to SQLite if omitted in local dev mode)
# For production (PostgreSQL / Supabase / Neon / AWS RDS):
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/smart_attendance

# Authentication & Security
SECRET_KEY=change_this_to_a_secure_random_64_char_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini AI API Key (For AI Timetable Scheduling & Smart Optimization)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Resend Email Automation API Key (https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Optional: Fallback Direct SMTP Configuration (e.g. Gmail App Password)
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Admin Alert Recipient Email
NOTIFICATION_RECIPIENT_EMAIL=admin@yourinstitution.edu

# Allowed CORS Origins (Comma-separated list of deployed frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

