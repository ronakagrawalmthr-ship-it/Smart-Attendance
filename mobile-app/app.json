{
  "expo": {
    "name": "Smart Attendance - Teacher Kiosk",
    "slug": "smart-attendance-teacher",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan student faces for biometric attendance verification.",
        "NSMicrophoneUsageDescription": "Microphone access is required for camera operation."
      }
    },
    "android": {
      "package": "com.smartattendance.teacher",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Smart Attendance to access your camera for student face recognition."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c6883446-6e71-4e95-b071-33e9973ed2cf"
      }
    }
  }
}
